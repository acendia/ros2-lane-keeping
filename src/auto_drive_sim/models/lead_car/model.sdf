<?xml version="1.0" ?>
<!--
  Red lead car used for follow checks.

  Dimensions and masses are documented in docs/car.md. The model origin is at
  ground level between the wheels. Positive X is forward, positive Y is left,
  and positive Z is up.
-->
<sdf version="1.9">
  <model name="lead_car">
    <static>false</static>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
    <self_collide>false</self_collide>

    <link name="chassis">
      <pose>0 0 0.57 0 0 0</pose>
      <inertial>
        <mass>700.0</mass>
        <inertia>
          <ixx>163.916667</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>856.675000</iyy>
          <iyz>0.0</iyz>
          <izz>991.666667</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <geometry>
          <box>
            <size>3.8 1.6 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.04 0.02 1</ambient>
          <diffuse>0.85 0.10 0.02 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="rear_skirt">
        <pose>-1.85 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 1.6 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.04 0.02 1</ambient>
          <diffuse>0.85 0.10 0.02 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="cabin">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>1.8 1.4 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.10 1</ambient>
          <diffuse>0.08 0.10 0.18 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="camera_mast">
        <pose>1.4 0 0.49 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.08 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>3.8 1.6 0.5</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_left_steering_link">
      <pose>1.2 0.7 0.32 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.002500</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.002500</iyy>
          <iyz>0.0</iyz>
          <izz>0.001250</izz>
        </inertia>
      </inertial>
      <visual name="hub">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <link name="front_right_steering_link">
      <pose>1.2 -0.7 0.32 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.002500</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.002500</iyy>
          <iyz>0.0</iyz>
          <izz>0.001250</izz>
        </inertia>
      </inertial>
      <visual name="hub">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <link name="front_left_wheel">
      <pose>1.2 0.7 0.32 -1.5707 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.347200</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.347200</iyy>
          <iyz>0.0</iyz>
          <izz>0.614400</izz>
        </inertia>
      </inertial>
      <visual name="tyre">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="side_marker">
        <pose>0 0 0.101 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_right_wheel">
      <pose>1.2 -0.7 0.32 -1.5707 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.347200</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.347200</iyy>
          <iyz>0.0</iyz>
          <izz>0.614400</izz>
        </inertia>
      </inertial>
      <visual name="tyre">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="side_marker">
        <pose>0 0 0.101 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_left_wheel">
      <pose>-1.2 0.7 0.32 -1.5707 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.347200</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.347200</iyy>
          <iyz>0.0</iyz>
          <izz>0.614400</izz>
        </inertia>
      </inertial>
      <visual name="tyre">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="side_marker">
        <pose>0 0 -0.101 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_right_wheel">
      <pose>-1.2 -0.7 0.32 -1.5707 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.347200</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.347200</iyy>
          <iyz>0.0</iyz>
          <izz>0.614400</izz>
        </inertia>
      </inertial>
      <visual name="tyre">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="side_marker">
        <pose>0 0 -0.101 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.8 0.1 1</ambient>
          <diffuse>1.0 0.9 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.55</lower>
          <upper>0.55</upper>
          <velocity>1.0</velocity>
          <effort>250</effort>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.55</lower>
          <upper>0.55</upper>
          <velocity>1.0</velocity>
          <effort>250</effort>
        </limit>
      </axis>
    </joint>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>1.4</kingpin_width>
      <steering_limit>0.55</steering_limit>
      <wheel_base>2.4</wheel_base>
      <wheel_separation>1.4</wheel_separation>
      <wheel_radius>0.32</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>3.0</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/lead/cmd_vel</topic>
      <odom_topic>/lead/odometry</odom_topic>
      <tf_topic>/lead/odom_tf</tf_topic>
    </plugin>
  </model>
</sdf>
