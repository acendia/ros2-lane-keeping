<?xml version="1.0" ?>
<!--
  Third track variant: dashed and worn markings under low sun with shadows.
-->
<sdf version="1.9">
  <world name="car_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.30 0.30 0.32 1</ambient>
      <background>0.35 0.50 0.72 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>1.0 0.93 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.0 0.8 -0.6</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.24 0.16 1</ambient>
            <diffuse>0.24 0.32 0.20 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="shadow_building_0">
      <static>true</static>
      <pose>-6 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_1">
      <static>true</static>
      <pose>1 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_2">
      <static>true</static>
      <pose>8 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_3">
      <static>true</static>
      <pose>14 9 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <include>
      <uri>model://road_markings</uri>
      <name>road</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://car</uri>
      <name>car</name>
      <pose>-10 15 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
