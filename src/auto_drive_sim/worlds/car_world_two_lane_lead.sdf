<?xml version="1.0" ?>
<!--
  Two-lane variant: the car starts in the right lane.
-->
<sdf version="1.9">
  <world name="car_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.55 0.70 0.90 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.24 0.16 1</ambient>
            <diffuse>0.24 0.32 0.20 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://road_two_lane</uri>
      <name>road</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="lead_vehicle">
      <static>true</static>
      <pose>8 13.19 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><box><size>3.0 1.6 1.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><box><size>3.0 1.6 1.3</size></box></geometry>
          <material>
            <ambient>0.55 0.05 0.02 1</ambient>
            <diffuse>0.85 0.12 0.03 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://car</uri>
      <name>car</name>
      <pose>-10 13.19 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
