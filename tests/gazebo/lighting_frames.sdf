<?xml version="1.0" ?>
<!--
  Post-release lighting frames. The same six cameras as the dashed frame set
  look at the oval under low sun and with shadow-casting buildings. The sun
  comes from the south so the building shadows cross the lane.
-->
<sdf version="1.9">
  <world name="lighting_frames">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>0.30 0.30 0.32 1</ambient>
      <background>0.35 0.50 0.72 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>1.0 0.93 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.0 0.8 -0.6</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.24 0.16 1</ambient>
            <diffuse>0.24 0.32 0.20 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <model name="shadow_building_0">
      <static>true</static>
      <pose>-6 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_1">
      <static>true</static>
      <pose>1 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_2">
      <static>true</static>
      <pose>8 11 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="shadow_building_3">
      <static>true</static>
      <pose>14 9 3.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 6.5</size></box></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.16 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://road_markings</uri>
      <name>road</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="cam_straight_start">
      <static>true</static>
      <pose>-8.6 15.0 1.3 0 0.05 0.0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/straight_start/image</topic>
        </sensor>
      </link>
    </model>

    <model name="cam_straight_mid">
      <static>true</static>
      <pose>-3.2 15.0 1.3 0 0.05 0.0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/straight_mid/image</topic>
        </sensor>
      </link>
    </model>

    <model name="cam_straight_east">
      <static>true</static>
      <pose>3.8 15.0 1.3 0 0.05 0.0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/straight_east/image</topic>
        </sensor>
      </link>
    </model>

    <model name="cam_right_curve">
      <static>true</static>
      <pose>10.0 15.0 1.3 0 0.05 -0.4</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/right_curve/image</topic>
        </sensor>
      </link>
    </model>

    <model name="cam_left_curve">
      <static>true</static>
      <pose>-10.0 15.0 1.3 0 0.05 3.5416</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/left_curve/image</topic>
        </sensor>
      </link>
    </model>
    <model name="cam_straight_curve_entry">
      <static>true</static>
      <pose>6.55 15.0 1.3 0 0.05 0.0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/lighting_frames/straight_curve_entry/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
